{
  "config": {
    // Advisory, CVE and upstream-documentation URLs are frequently longer than
    // the wrap column and cannot be broken without breaking the link. Prose,
    // which is what the rule is for, still wraps at 80.
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false,
      "strict": false
    }
  }
}
