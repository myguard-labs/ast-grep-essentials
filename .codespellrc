# Deliberate PowerShell parameter-prefix spellings, not typos. Rules that
# enumerate unambiguous `-Parameter` prefixes (so a rule matches the same
# abbreviations PowerShell itself accepts) necessarily contain truncated
# words: `-Comman` for `-Command`, `-NoE`/`-NoEn` for `-NoEncryption`.
# Scoped to those tokens only; every other misspelling still fails the gate.
[codespell]
ignore-words-list = comman,noe,noen
